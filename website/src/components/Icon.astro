---
import { Icon as Iconify } from 'astro-icon/components';
import { iconNames, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  /** Accessible label; omit for purely decorative icons. */
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
---

<Iconify
  name={iconNames[name]}
  width={size}
  height={size}
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
/>
