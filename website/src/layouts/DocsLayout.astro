---
import DocsSidebar from '../components/DocsSidebar.astro';
import Base from './Base.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  updated?: Date;
}

const { title, description, updated } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    url: canonical,
    ...(updated ? { dateModified: updated.toISOString().slice(0, 10) } : {}),
    author: { '@type': 'Organization', name: site.name, url: site.repoUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'inup',
        item: new URL(`${base}/`, Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Docs',
        item: new URL(`${base}/docs/getting-started/`, Astro.site).href,
      },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ],
  },
];
---

<Base title={`${title} — inup docs`} description={description} jsonLd={jsonLd}>
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 py-12 lg:grid-cols-[220px_1fr]">
    <DocsSidebar />
    <article class="prose min-w-0">
      <h1>{title}</h1>
      <slot />
      {updated && (
        <p class="mt-10 border-t border-border pt-4 text-sm text-muted-foreground">
          Last updated {updated.toISOString().slice(0, 10)} · <a href={`${site.repoUrl}/blob/main/README.md`}>Source on GitHub</a>
        </p>
      )}
    </article>
  </div>
</Base>
