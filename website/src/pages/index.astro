---
import ComparisonTable from '../components/ComparisonTable.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import Base from '../layouts/Base.astro';
// The real recording from the repo (the README embeds the gif variant) —
// imported from docs/demo/ so re-recording the demo updates the site
// automatically. record-demo.sh emits the mp4 alongside the gif.
import demoVideo from '../../../docs/demo/interactive-upgrade.mp4';
import demoPoster from '../assets/demo-poster.webp';
import { site } from '../data/site';
import { stats } from '../lib/stats';
import type { IconName } from '../components/icons';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  description:
    'Interactive dependency upgrader for npm, yarn, pnpm and bun. Zero-config, monorepo-ready, with vulnerability audit and changelogs in the terminal.',
  url: new URL(`${base}/`, Astro.site).href,
  downloadUrl: site.npmUrl,
  softwareVersion: stats.version,
  license: 'https://opensource.org/license/mit',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const features: Array<{ icon: IconName; keys: string[]; title: string; body: string }> = [
  {
    icon: 'shield-check',
    keys: ['s'],
    title: 'Audit before you upgrade',
    body: 'Known vulnerabilities appear next to each package, cross-referenced against the upgrade target — so you know whether the bump actually fixes the advisory.',
  },
  {
    icon: 'book-open',
    keys: ['i'],
    title: 'Changelogs in the terminal',
    body: 'Read release notes inline before selecting a major. No browser tab, no guessing what changed.',
  },
  {
    icon: 'search',
    keys: ['/'],
    title: 'Search the picker',
    body: 'Filter hundreds of workspace dependencies as you type. Esc clears.',
  },
  {
    icon: 'sliders',
    keys: ['d', 'p', 'o'],
    title: 'Live dependency-type toggles',
    body: 'Show or hide dev, peer and optional dependencies on the fly — instead of restarting with different flags.',
  },
  {
    icon: 'list-checks',
    keys: ['m', 'l'],
    title: 'Bulk select, precisely',
    body: 'Select every safe in-range update with one key, or everything including majors — then deselect the risky ones.',
  },
  {
    icon: 'arrow-left-right',
    keys: ['←', '→'],
    title: 'Range or latest, per package',
    body: 'Cycle each package between no upgrade, the in-range bump and the latest major. Mixed strategies in one pass.',
  },
];
---

<Base
  title="inup — interactive dependency upgrader for npm, yarn, pnpm & bun"
  description="The upgrade-interactive npm never shipped. inup upgrades outdated dependencies from an interactive terminal UI — with vulnerability audit, changelogs, monorepo and pnpm catalog support. Run npx inup."
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" as="image" href={demoPoster.src} />
  <div class="mx-auto max-w-6xl px-6">
    <!-- Hero -->
    <section class="pt-16 pb-14 text-center sm:pt-24">
      <p class="m-0 mb-7 flex justify-center">
        <a
          href={`${base}/changelog/`}
          class="inline-flex items-center gap-2 rounded-full border border-brand/25 bg-brand/5 py-1 pr-3.5 pl-2.5 font-mono text-xs text-brand no-underline transition-colors hover:border-brand/50"
        >
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand opacity-60 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2 rounded-full bg-brand"></span>
          </span>
          v{stats.version} · interactive dependency upgrader
        </a>
      </p>
      <h1
        class="mx-auto m-0 mb-6 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl lg:leading-[1.08]"
      >
        The <code
          class="bg-gradient-to-r from-brand-2 to-brand bg-clip-text font-mono tracking-tighter text-transparent sm:whitespace-nowrap"
        >upgrade-interactive</code> npm never shipped.
      </h1>
      <p class="mx-auto m-0 mb-9 max-w-[54ch] text-lg text-pretty text-muted-foreground">
        yarn, pnpm, bun and deno each bundle one — npm doesn't. inup is one
        command that works with <strong class="text-foreground">all of them</strong>:
        pick upgrades in an interactive terminal UI, see vulnerabilities and
        changelogs before you commit to anything. Zero config, monorepo-ready.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          data-copy-install
          class="inline-flex h-12 cursor-pointer items-center gap-3 rounded-xl bg-terminal px-5 font-mono text-base text-terminal-foreground shadow-md transition-shadow hover:shadow-lg"
          aria-label="Copy 'npx inup' to the clipboard"
        >
          <span class="select-none text-term-green" aria-hidden="true">$</span> npx inup
          <span class="copy-hint text-terminal-muted" aria-hidden="true"><Icon name="copy" size={14} /></span>
          <span class="copied-hint hidden text-term-green" aria-hidden="true"><Icon name="check" size={14} /></span>
        </button>
        <a
          href={`${base}/docs/getting-started/`}
          class="inline-flex h-12 items-center gap-1.5 rounded-xl border border-border bg-surface px-5 text-sm font-medium no-underline shadow-xs transition-all hover:border-brand/40 hover:shadow-md hover:shadow-brand/5"
        >
          Read the docs <Icon name="arrow-up-right" size={15} class="text-brand" />
        </a>
      </div>
      <p class="mt-5 mb-0 font-mono text-xs text-muted-foreground">
        or install: npm i -g inup · pnpm add -g inup · yarn global add inup · bun add -g inup
      </p>

      <figure class="mx-auto m-0 mt-14 max-w-5xl">
        <div class="rounded-2xl bg-gradient-to-b from-brand-2/25 via-brand/10 to-transparent p-px">
          <video
            autoplay
            loop
            muted
            playsinline
            poster={demoPoster.src}
            width={1240}
            height={510}
            aria-label="Recording of inup's interactive picker: browsing outdated packages across workspaces, selecting upgrades, and applying them"
            class="w-full rounded-2xl bg-terminal shadow-[0_32px_64px_-32px_color-mix(in_srgb,var(--brand)_45%,var(--terminal))]"
          >
            <source src={demoVideo} type="video/mp4" />
          </video>
        </div>
        <figcaption class="mt-4 text-center font-mono text-xs text-muted-foreground">
          real session, recorded with vhs — not a mockup
        </figcaption>
      </figure>

      <div class="mt-9 flex justify-center">
        <Stats monthlyDownloads={stats.monthlyDownloads} stars={stats.stars} />
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="section scroll-mt-16">
      <p class="eyebrow">
        <Icon name="terminal" size={15} class="text-brand" /> the picker
      </p>
      <h2 class="m-0 mb-3 text-2xl font-bold tracking-tight sm:text-3xl">
        The picker knows more than <code class="font-mono">outdated</code> does
      </h2>
      <p class="m-0 mb-10 max-w-[66ch] text-muted-foreground">
        Every feature is a keystroke away — no flags to remember, no re-runs.
        Dev, peer and optional dependencies load automatically.
      </p>
      <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <li
            class="rounded-2xl border border-border bg-surface p-6 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-brand/35 hover:shadow-lg hover:shadow-brand/5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            <div class="flex items-start justify-between">
              <span class="flex size-10 items-center justify-center rounded-xl bg-brand/10 text-brand ring-1 ring-brand/15">
                <Icon name={f.icon} size={20} />
              </span>
              <span class="flex gap-1">
                {f.keys.map((k) => <span class="keycap">{k}</span>)}
              </span>
            </div>
            <h3 class="mt-4 mb-1.5 text-base font-semibold">{f.title}</h3>
            <p class="m-0 text-sm leading-relaxed text-muted-foreground">{f.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Monorepo -->
    <section id="monorepo" class="section scroll-mt-16">
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2">
        <div>
          <p class="eyebrow">
            <Icon name="git-branch" size={15} class="text-brand" /> monorepos
          </p>
          <h2 class="m-0 mb-4 text-2xl font-bold tracking-tight sm:text-3xl">
            Monorepos and pnpm catalogs, without ceremony
          </h2>
          <p class="m-0 mb-4 text-muted-foreground">
            inup discovers every workspace in one pass. Dependencies declared
            as <code>catalog:</code> are resolved from
            <code>pnpm-workspace.yaml</code> and upgraded right there — with
            the file's comments and formatting preserved, not rewritten.
          </p>
          <p class="m-0 text-muted-foreground">
            Private registries work exactly like npm's own resolution: scoped
            registries and credentials from your project, user and global
            <code>.npmrc</code>, including <code>$&lbrace;ENV_VAR&rbrace;</code> expansion.
          </p>
        </div>
        <pre
          class="m-0 overflow-x-auto rounded-xl border border-terminal-border bg-terminal p-5 font-mono text-sm leading-7 text-terminal-foreground"><code><span class="text-terminal-muted"># pnpm-workspace.yaml — comments survive the upgrade</span>
catalog:
  <span class="text-terminal-muted"># pinned for the design system</span>
  react: <span class="text-term-green">^18.3.1</span>
  vue: <span class="text-term-green">^3.5.13</span></code></pre>
      </div>
    </section>

    <!-- CI -->
    <section id="ci" class="section scroll-mt-16">
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2">
        <div>
          <p class="eyebrow">
            <Icon name="workflow" size={15} class="text-brand" /> automation
          </p>
          <h2 class="m-0 mb-4 text-2xl font-bold tracking-tight sm:text-3xl">
            Headless in CI, by default
          </h2>
          <p class="m-0 mb-4 text-muted-foreground">
            When stdout isn't a TTY or <code>$CI</code> is set, inup never
            opens the UI — it reports. <code>--check</code> and
            <code>--json</code> are guaranteed read-only, and JSON output
            carries a <code>schemaVersion</code> so scripts and agents can pin
            to a known shape.
          </p>
          <p class="m-0 text-muted-foreground">
            The <a
              href={`${base}/docs/github-action/`}
              class="link"
            >GitHub Action</a> runs inup on a schedule and maintains one rolling
            pull request with safe upgrades applied — re-runs update the same PR.
          </p>
        </div>
        <pre
          class="m-0 overflow-x-auto rounded-xl border border-terminal-border bg-terminal p-5 font-mono text-sm leading-7 text-terminal-foreground"><code><span class="text-terminal-muted"># gate the build on outdated deps</span>
inup --check

<span class="text-terminal-muted"># structured report for dashboards & bots</span>
inup --json | jq '.summary'

<span class="text-terminal-muted"># apply safe in-range bumps + install</span>
inup --apply <span class="text-term-amber">--target minor</span></code></pre>
      </div>
    </section>

    <!-- Compare -->
    <section id="compare" class="section scroll-mt-16">
      <p class="eyebrow">
        <Icon name="scale" size={15} class="text-brand" /> comparison
      </p>
      <h2 class="m-0 mb-3 text-2xl font-bold tracking-tight sm:text-3xl">How inup compares</h2>
      <p class="m-0 mb-8 max-w-[66ch] text-muted-foreground">
        Honest marks — including the rows where the others win. Verified
        against each tool's documentation on 2026-07-06.
      </p>
      <ComparisonTable columns={['inup', 'ncu', 'taze', 'builtin']} homepageOnly />
      <p class="mt-4 mb-0 max-w-[66ch] text-sm text-muted-foreground">
        "PM built-ins" = <code>yarn upgrade-interactive</code>,
        <code>pnpm update -i</code>, <code>bun update -i</code>,
        <code>deno outdated -i</code> — each works with its own package manager
        only. Detailed head-to-heads:{' '}
        <a href={`${base}/vs/npm-check-updates/`} class="link">inup vs npm-check-updates</a>,{' '}
        <a href={`${base}/vs/taze/`} class="link">inup vs taze</a>,{' '}
        <a href={`${base}/vs/npm-check/`} class="link">inup vs npm-check</a>.
      </p>
    </section>

    <!-- Privacy + CTA -->
    <section id="privacy" class="section scroll-mt-16">
      <div
        class="rounded-3xl border border-brand/20 bg-surface bg-gradient-to-b from-brand/8 via-transparent to-transparent p-8 text-center sm:p-14"
      >
        <p class="eyebrow justify-center">
          <Icon name="lock" size={15} class="text-brand" /> no telemetry
        </p>
        <h2 class="m-0 mb-4 text-2xl font-bold tracking-tight sm:text-3xl">
          Try it on your messiest repo
        </h2>
        <p class="mx-auto mt-0 mb-8 max-w-[52ch] text-muted-foreground">
          No tracking, no data collection. Package metadata comes straight from
          the npm registry, download counts from the npm downloads API, and
          changelogs from GitHub. {site.license} licensed —{' '}
          <a href={site.repoUrl} class="link">read the source</a>.
        </p>
        <button
          type="button"
          data-copy-install
          class="inline-flex cursor-pointer items-center gap-3 rounded-xl bg-terminal px-6 py-4 font-mono text-lg text-terminal-foreground shadow-md transition-shadow hover:shadow-lg"
          aria-label="Copy 'npx inup' to the clipboard"
        >
          <span class="select-none text-term-green" aria-hidden="true">$</span> npx inup
          <span class="copy-hint text-terminal-muted" aria-hidden="true"><Icon name="copy" size={15} /></span>
          <span class="copied-hint hidden text-term-green" aria-hidden="true"><Icon name="check" size={15} /></span>
        </button>
      </div>
    </section>
  </div>
</Base>

<script>
  // The hero recording autoplays; honor reduced-motion by pausing it
  // and surfacing controls so it can still be played deliberately.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const video = document.querySelector<HTMLVideoElement>('video[autoplay]');
    if (video) {
      video.pause();
      video.removeAttribute('autoplay');
      video.controls = true;
    }
  }

  // The install command copies itself.
  for (const chip of document.querySelectorAll('[data-copy-install]')) {
    chip.addEventListener('click', async () => {
      await navigator.clipboard.writeText('npx inup');
      chip.querySelector('.copy-hint')?.classList.add('hidden');
      chip.querySelector('.copied-hint')?.classList.remove('hidden');
      setTimeout(() => {
        chip.querySelector('.copy-hint')?.classList.remove('hidden');
        chip.querySelector('.copied-hint')?.classList.add('hidden');
      }, 1500);
    });
  }
</script>
