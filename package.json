{
  "name": "inup",
  "version": "1.6.11",
  "description": "Interactive dependency upgrader for npm, yarn, pnpm & bun. Zero-config, monorepo-ready. Upgrade-interactive for every package manager.",
  "main": "dist/index.js",
  "bin": {
    "inup": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepare": "npm run build",
    "link": "pnpm build && pnpm add -g .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "typecheck": "tsc --noEmit",
    "demo:record": "bash docs/demo/record-demo.sh",
    "demo:setup": "cd docs/demo-project && pnpm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=coverage/test-results.json",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "docs:keys": "UPDATE_README=1 vitest run keymap-readme",
    "docs:badges": "pnpm test:coverage && UPDATE_README=1 vitest run badges-readme",
    "site:dev": "pnpm --filter @inup/website dev",
    "site:build": "pnpm --filter @inup/website build",
    "site:preview": "pnpm --filter @inup/website preview"
  },
  "author": "Donfear",
  "keywords": [
    "upgrade-interactive",
    "interactive",
    "dependency-management",
    "outdated",
    "upgrade",
    "update",
    "npm",
    "yarn",
    "pnpm",
    "bun",
    "monorepo",
    "workspace",
    "cli",
    "vulnerability",
    "audit",
    "changelog",
    "package-manager",
    "dependencies",
    "semver",
    "ncu",
    "renovate",
    "dependabot"
  ],
  "license": "MIT",
  "homepage": "https://donfear.github.io/inup/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donfear/inup.git"
  },
  "bugs": {
    "url": "https://github.com/donfear/inup/issues"
  },
  "files": [
    "dist/**/*.js",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^25.9.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-truncate": "^6.1.1",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "nanospinner": "^1.2.2",
    "registry-auth-token": "^5.1.1",
    "semver": "^7.8.5",
    "string-width": "^8.2.2",
    "undici": "^8.10.0",
    "wrap-ansi": "^10.0.1",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
