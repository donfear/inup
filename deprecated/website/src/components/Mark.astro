---
import Icon from './Icon.astro';

interface Props {
  v: 'yes' | 'no';
}

const { v } = Astro.props;
const label = v === 'yes' ? 'Yes' : 'No';
---

<span class={`inline-flex items-center justify-center ${v === 'yes' ? 'text-success' : 'text-muted-foreground opacity-60'}`}>
  <Icon name={v === 'yes' ? 'check' : 'x'} size={16} label={label} />
</span>
