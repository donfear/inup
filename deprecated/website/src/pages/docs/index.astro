---
import DocsSidebar from '../../components/DocsSidebar.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { getDocsNav } from '../../lib/docs-nav';
import { base } from '../../lib/url';
import { site } from '../../data/site';
import type { IconName } from '../../components/icons';

const icons: Record<string, IconName> = {
  'getting-started': 'zap',
  cli: 'terminal',
  'keyboard-shortcuts': 'keyboard',
  configuration: 'sliders',
  ci: 'workflow',
  'github-action': 'github',
};

const nav = await getDocsNav();
const pages = nav
  .filter((item) => item.order > 0)
  .map((item) => {
    const slug = item.href.replace(/\/$/, '').split('/').pop() ?? '';
    return { ...item, icon: icons[slug] ?? ('book-open' as IconName) };
  });
---

<Base
  title="Documentation — inup"
  description="Everything about inup: getting started, the CLI reference, keyboard shortcuts, .inuprc configuration, CI & scripting, and the GitHub Action."
>
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 py-12 lg:grid-cols-[220px_1fr]">
    <DocsSidebar nav={nav} />
    <div class="min-w-0">
      <h1 class="m-0 mb-3 text-3xl font-bold tracking-tight">Documentation</h1>
      <p class="m-0 mb-8 max-w-[60ch] text-muted-foreground">
        Everything you need to run inup — from <code>npx inup</code> to a
        scheduled GitHub Action maintaining one rolling upgrade PR. Prefer
        reading in your terminal? The full docs are also served as{' '}
        <a class="link" href={`${base}/llms-full.txt`}>plain text</a>.
      </p>
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2">
        {pages.map((p) => (
          <li>
            <a
              href={p.href}
              class="card-lift flex h-full flex-col p-5 no-underline"
            >
              <span class="mb-3 flex size-9 items-center justify-center rounded-lg bg-brand/10 text-brand ring-1 ring-brand/15">
                <Icon name={p.icon} size={18} />
              </span>
              <span class="mb-1 font-semibold">{p.title}</span>
              <span class="text-sm leading-relaxed text-muted-foreground">{p.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-sm text-muted-foreground">
        Can't find something? <a class="link" href={site.issuesUrl}>Open an issue</a> — or press
        <span class="keycap mx-1">?</span> inside inup for help in the terminal.
      </p>
    </div>
  </div>
</Base>
